<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 与接口 com.offblink.chapter05.EmpRelationMapper 同包同名（resources/com/offblink/chapter05/）：
     <mapper class> 注册时会自动找到本文件 -->
<!-- 表名一律 schema 限定 ssm_emp.xxx：本项目 JDBC URL 指向 mybatis_db，
     不限定 schema 的话 employer/dept 会被解析到 mybatis_db 而报 Table doesn't exist -->
<mapper namespace="com.offblink.chapter05.EmpRelationMapper">

    <!--
        ==================== resultMap：员工 + 部门 ====================
        一对一 / 多对一 共用这一份映射。
        关联方向判定：外键 dept_id 在 employer 上 → 从员工看是"多对一"（多个员工共用一个部门），
        从部门看是"一对多"。映射标签不看业务名词，只看属性是"一个对象"还是"一个集合"：
          · 一个对象 → <association> （javaType 写这个对象是什么类）
          · 一个集合 → <collection>  （ofType 写集合里装的是什么类）
    -->
    <resultMap id="empWithDeptMap" type="Emp">
        <id property="empId" column="emp_id"/>
        <result property="empName" column="emp_name"/>
        <result property="gender" column="gender"/>
        <result property="dept" column="dept"/>
        <result property="post" column="post"/>
        <result property="salary" column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status" column="status"/>
        <!--
            本表的外键列必须起别名：employer 和 dept 都叫 dept_id，
            不起别名的话结果集里两列同名，映射时分不清"员工属于哪个部门"和"部门自己是几号"，
            员工自己的 deptId 会被部门的 deptId 覆盖（这就是老师强调的坑）
        -->
        <result property="deptId" column="emp_dept_id"/>
        <!-- 关联对象：property 是 Emp 里的属性名，不是表名 -->
        <association property="deptInfo" javaType="Dept">
            <id property="deptId" column="dept_id"/>
            <result property="deptName" column="dept_name"/>
            <result property="loc" column="loc"/>
        </association>
    </resultMap>

    <!-- ==================== 一对一（XML 方式） ==================== -->
    <!-- 嵌套结果映射：一条 LEFT JOIN 把两张表的列一次查回来，resultMap 内部逐列声明 -->
    <select id="one2oneByXml" parameterType="int" resultMap="empWithDeptMap">
        SELECT e.emp_id, e.emp_name, e.gender, e.dept, e.post, e.salary, e.hire_date, e.status,
               e.dept_id AS emp_dept_id,
               d.dept_id, d.dept_name, d.loc
        FROM ssm_emp.employer e
        LEFT JOIN ssm_emp.dept d ON e.dept_id = d.dept_id
        WHERE e.emp_id = #{empId}
    </select>

    <!-- ==================== 多对一（XML 方式） ==================== -->
    <!--
        和上面一条只有一个区别：没有 WHERE，一次查一批员工，每人各带一个部门对象。
        语句不同、方法不同，但 resultMap 完全复用 —— 这就是"一对一与多对一在 MyBatis 里
        写法相同"的实证：两者的业务语义（一个员工只有一个部门 / 多个员工共用一个部门）
        只在"从哪一侧发起查询、查一条还是查一批"上体现。
        ORDER BY 只为输出顺序稳定，与查询语义无关。
    -->
    <select id="many2oneByXml" resultMap="empWithDeptMap">
        SELECT e.emp_id, e.emp_name, e.gender, e.dept, e.post, e.salary, e.hire_date, e.status,
               e.dept_id AS emp_dept_id,
               d.dept_id, d.dept_name, d.loc
        FROM ssm_emp.employer e
        LEFT JOIN ssm_emp.dept d ON e.dept_id = d.dept_id
        ORDER BY e.emp_id
    </select>

    <!--
        ==================== resultMap：员工 + 技能（多对多） ====================
        员工与技能之间没有外键可用（一个员工多项技能、一项技能多个员工），
        关系存在中间表 employer_skill 里，所以查技能必须"穿过"中间表：
        employer → employer_skill → skill。
        映射侧仍是 <collection>（属性是集合），ofType 写集合里的元素类型 Skill。
    -->
    <resultMap id="empWithSkillsMap" type="Emp">
        <id property="empId" column="emp_id"/>
        <result property="empName" column="emp_name"/>
        <result property="gender" column="gender"/>
        <result property="dept" column="dept"/>
        <result property="post" column="post"/>
        <result property="salary" column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status" column="status"/>

        <!-- 技能侧同样起别名：id/name 是两张表都有的通用列名，不起别名会和 emp_id/emp_name 撞车 -->
        <collection property="skills" ofType="Skill">
            <id property="id" column="skill_id"/>
            <result property="name" column="skill_name"/>
            <result property="description" column="skill_desc"/>
        </collection>
    </resultMap>

    <!-- ==================== 多对多（XML 方式） ==================== -->
    <!--
        两次 LEFT JOIN + DISTINCT（老师的写法）。这里有个值得记住的细节：
        本例中间表的主键是 (emp_id, skill_id)，不可能出现重复关系，
        所以 DISTINCT 实际上一条行都去不掉 —— 真正把 N 行"归并成一个员工 + N 个技能"
        的是上面 <id property="empId">。
        DISTINCT 只有在 JOIN 真会产生完全相同的行（比如中间表被重复插入）时才有活干。
        （自动映射那套靠"列名全不相同"照样能映射，但显式声明才能讲清哪个列进哪个对象）

        实测（MyBatis 3.5.10 / 本项目 EmpRelationMapperTest.testMany2manyByXml）：
        员工赵敏在中间表里没有任何关系时，这条 SQL 仍然返回 1 行（skill 侧整行全为 null，
        日志里的 Total: 1 就是它），但映射层不会造出"全 null 的技能对象"，
        Emp.skills 得到的是空集合 []（MyBatis 判断嵌套 resultMap 的所有列都为 null 就跳过该元素）。
        所以老师讲义里"LEFT JOIN 会产生全 null 的技能对象"这条在 3.5.x 上不成立 ——
        真实代价是白查了一行的网络/带宽，而不是集合里多个脏对象。
    -->
    <select id="many2manyByXml" parameterType="int" resultMap="empWithSkillsMap">
        SELECT DISTINCT e.emp_id, e.emp_name, e.gender, e.dept, e.post, e.salary, e.hire_date, e.status,
               s.id AS skill_id, s.name AS skill_name, s.description AS skill_desc
        FROM ssm_emp.employer e
        LEFT JOIN ssm_emp.employer_skill es ON e.emp_id = es.emp_id
        LEFT JOIN ssm_emp.skill s ON es.skill_id = s.id
        WHERE e.emp_id = #{empId}
    </select>

</mapper>
