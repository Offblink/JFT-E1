<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 与接口 com.offblink.lab01.EmpMapper 同包同名（resources/com/offblink/lab01/）：
     <mapper class> 注册和 cfg.addMapper() 都能自动发现本文件 -->
<!-- 表名一律 schema 限定为 ssm_emp.employer：本项目共用一个数据源（URL 指向 mybatis_db），
     未限定的 emp 会被解析到当前库 mybatis_db 而报 Table doesn't exist -->
<mapper namespace="com.offblink.lab01.EmpMapper">

    <!-- 自定义结果映射：emp_id/emp_name/hire_date 与属性名不一致，显式声明（指导书任务 2.3） -->
<!--    在这里！type是模型类，property是属性名，column是映射的名称-->
<!--    当然，可以使用注解完成，只是这样也体现不出注解简洁的优势了-->
<!--    注解适用于简单的情况，当情况变复杂，我们倾向于写成java+xml-->
    <resultMap id="empMap" type="Emp">
        <id property="empId" column="emp_id"/>
        <result property="empName" column="emp_name"/>
        <result property="gender" column="gender"/>
        <result property="dept" column="dept"/>
        <result property="post" column="post"/>
        <result property="salary" column="salary"/>
        <result property="hireDate" column="hire_date"/>
        <result property="status" column="status"/>
    </resultMap>

    <!-- 全字段 SQL 片段：一处维护，<include> 复用 -->
    <sql id="allColumns">
        emp_id, emp_name, gender, dept, post, salary, hire_date, status
    </sql>

    <!-- ==================== 基础 CRUD ==================== -->

<!--    resultMap为返回映射，往上看（一般用于多表查询等复杂情况-->
    <select id="selectAll" resultMap="empMap">
        SELECT <include refid="allColumns"/> FROM ssm_emp.employer
    </select>

    <select id="selectEmpById" parameterType="int" resultMap="empMap">
        SELECT <include refid="allColumns"/> FROM ssm_emp.employer WHERE emp_id = #{empId}
    </select>

    <!-- 自增主键回填到 emp.empId；hire_date/status 由调用方传入 -->
    <insert id="insertEmp" parameterType="Emp" useGeneratedKeys="true" keyProperty="empId">
        INSERT INTO ssm_emp.employer (emp_name, gender, dept, post, salary, hire_date, status)
        VALUES (#{empName}, #{gender}, #{dept}, #{post}, #{salary}, #{hireDate}, #{status})
    </insert>

    <update id="updateEmp" parameterType="Emp">
        UPDATE ssm_emp.employer
        SET emp_name = #{empName}, gender = #{gender}, dept = #{dept},
            post = #{post}, salary = #{salary}, status = #{status}
        WHERE emp_id = #{empId}
    </update>

    <delete id="deleteEmpById" parameterType="int">
        DELETE FROM ssm_emp.employer WHERE emp_id = #{empId}
    </delete>

    <!-- ==================== 动态 SQL ==================== -->

    <!-- if/where：where 标签自动剔除开头多余的 AND/OR；空条件退化为全表查询 -->
    <select id="selectByCondition" parameterType="Emp" resultMap="empMap">
        SELECT <include refid="allColumns"/> FROM ssm_emp.employer
        <where>
            <if test="empName != null and empName != ''">
                AND emp_name LIKE CONCAT('%', #{empName}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender = #{gender}
            </if>
            <if test="dept != null and dept != ''">
                AND dept = #{dept}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </select>

    <!-- set：只拼接非空字段，末尾多余逗号由 set 标签剔除；全空字段生成非法 SQL（WHERE 不可少） -->
    <update id="updateDynamic" parameterType="Emp">
        UPDATE ssm_emp.employer
        <set>
            <if test="empName != null">emp_name = #{empName},</if>
            <if test="dept != null">dept = #{dept},</if>
            <if test="post != null">post = #{post},</if>
            <if test="salary != null">salary = #{salary},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE emp_id = #{empId}
    </update>

    <!-- foreach 批量删除：collection 对应 @Param("ids") -->
    <delete id="deleteBatch">
        DELETE FROM ssm_emp.employer WHERE emp_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- foreach 批量插入：多值 VALUES 列表 -->
    <insert id="insertBatch" useGeneratedKeys="true" keyProperty="empId">
        INSERT INTO ssm_emp.employer (emp_name, gender, dept, post, salary, hire_date, status) VALUES
        <foreach collection="list" item="e" separator=",">
            (#{e.empName}, #{e.gender}, #{e.dept}, #{e.post}, #{e.salary}, #{e.hireDate}, #{e.status})
        </foreach>
    </insert>

    <!-- choose/when/otherwise：互斥分支（if 是叠加条件，choose 是三选一） -->
    <select id="selectByChoice" resultMap="empMap">
        SELECT <include refid="allColumns"/> FROM ssm_emp.employer
        <choose>
            <when test="empName != null and empName != ''">
                WHERE emp_name = #{empName}
            </when>
            <when test="dept != null and dept != ''">
                WHERE dept = #{dept}
            </when>
            <otherwise>
                WHERE 1 = 1
            </otherwise>
        </choose>
    </select>

    <!--
        foreach 查询：按岗位集合 IN 查询（本次任务：一次查出「经理」和「销售员」）
        IN 括号里的元素个数随集合变化，没法用单个 ? 占位 → 只能靠 <foreach> 把集合摊成 (?, ?)。
        与上面的批量删除同一套路，两点差异：
          · collection 对应接口上的 @Param("posts")（表示查询的集合名称）
          · item 是 String 不是对象，直接取值即可，没有 #{x.field} 这一层
        ORDER BY emp_id 只为输出顺序稳定，与查询语义无关。
    -->
    <select id="selectByPosts" resultMap="empMap">
        SELECT <include refid="allColumns"/> FROM ssm_emp.employer
        WHERE post IN
        <foreach collection="posts" item="post" open="(" separator="," close=")">
            #{post}
        </foreach>
        ORDER BY emp_id
    </select>

    <!--
        foreach 一次性批量更新：集合里每个元素 = 一条独立的 UPDATE 动作，
        用 separator=";" 把它们拼成「UPDATE ...; UPDATE ...;」一条语句交给数据库，
        取代「循环调 N 次 updateDynamic」的 N 次网络往返。
        每条 UPDATE 内部再套 <set>，所以每个元素都能只改自己带的字段（没传的保持原值）。

        硬要求：JDBC URL 必须带 allowMultiQueries=true（db.properties 已加）。
        这是驱动的默认安全开关，不开的话驱动在解析阶段就报语法错误，跟 SQL 本身无关。

        限制（实测）：多语句下发时，MySQL Connector/J 的 executeUpdate 只回报【第一条】语句的
        影响行数（本例三条各改一行 → 返回 1，不是 3），所以拿返回值判断"改了几行"是不可靠的，
        要确认结果得回查。一次发多条也意味着这里不能用 useGeneratedKeys。
        与 updateDynamic 同样的坑：某个元素的待改字段全为 null 时 <set> 会退化成空串，那条语句非法。
    -->
    <update id="updateBatch">
        <foreach collection="list" item="e" separator=";">
            UPDATE ssm_emp.employer
            <set>
                <if test="e.empName != null">emp_name = #{e.empName},</if>
                <if test="e.dept != null">dept = #{e.dept},</if>
                <if test="e.post != null">post = #{e.post},</if>
                <if test="e.salary != null">salary = #{e.salary},</if>
                <if test="e.status != null">status = #{e.status},</if>
            </set>
            WHERE emp_id = #{e.empId}
        </foreach>
    </update>

</mapper>
